{
  "name": "asterwise",
  "version": "0.8.0",
  "description": "Official TypeScript SDK for the Asterwise API: Vedic and Western astrology, numerology, tarot. 117 endpoints, generated from the OpenAPI document; positions checked against NASA JPL Horizons; MCP server for Claude and Cursor.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "openapi-ts && node scripts/post-generate.mjs",
    "generate:verify": "git diff --stat src/ && echo '--- src/ regeneration diff above ---'",
    "build": "tsc && node fix-esm.mjs",
    "test": "npm run build && node --test tests/error_codes.test.mjs",
    "verify:nodenext": "bash scripts/verify-nodenext.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vedic-astrology",
    "jyotish",
    "astrology",
    "kundli",
    "horoscope",
    "numerology",
    "tarot",
    "panchanga",
    "dasha",
    "matchmaking",
    "western-astrology",
    "natal-chart",
    "astrology-api",
    "mcp",
    "swiss-ephemeris",
    "kundali-matching"
  ],
  "author": "Asterwise <support@asterwise.com>",
  "license": "MIT",
  "homepage": "https://asterwise.com/?utm_source=npm&utm_medium=package&utm_campaign=asterwise-typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asterwise/asterwise-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/asterwise/asterwise-typescript/issues"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "typescript": "^5.0.0"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
